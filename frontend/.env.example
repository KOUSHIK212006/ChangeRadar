# ChangeRadar Frontend Environment Configuration
# API base URL pointing to the FastAPI backend (Krishank's platform service)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Enable mock data fallback when backend is unavailable or for demo/evaluation
# Options: 'true' (use rich mock fixtures) or 'false' (live API requests)
VITE_USE_MOCK_DATA=true

# Polling interval in milliseconds for research job progress
VITE_POLL_INTERVAL_MS=3000

