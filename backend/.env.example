# ==============================================================================
# ChangeRadar Backend Environment Configuration
# ==============================================================================

# Application
APP_NAME=ChangeRadar Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Routing
API_V1_STR=/api/v1

# CORS - Comma-separated origins allowed to communicate with this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/changeradar
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# JWT Security
# Required in production: use a cryptographically random value of at least 32 characters.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# Intelligence Engine & Bifrost Centralized LLM Gateway
# ==============================================================================

# Mode: Set 'true' for local development and deterministic tests (no external API calls)
# Set 'false' when live Tavily & Bifrost/Gemini APIs are configured.
INTELLIGENCE_FIXTURE_MODE=true

# Search Provider: Tavily API
TAVILY_API_KEY=

# Centralized LLM Gateway: Bifrost (Maxim AI)
# All production LLM requests route through Bifrost (/v1/chat/completions)
BIFROST_BASE_URL=http://localhost:8088
BIFROST_API_KEY=
BIFROST_MODEL=gemini/gemini-3.5-flash-lite

# Primary LLM Provider: "bifrost" | "gemini" | "groq" | "openai"
LLM_PROVIDER=bifrost

# Upstream Google Gemini API Configuration (passed to Bifrost via x-goog-api-key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq Alternative Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Temperature (0.0 to 1.0)
INTELLIGENCE_LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30

# Quota & Retry Policies (Exponential backoff with jitter)
MAX_RETRIES=3
RETRY_BACKOFF_BASE=1.5
RETRY_BACKOFF_MAX=10.0

# Batching Budgets (Target: ~4–6 total LLM calls per run)
MAX_ARTICLES_PER_BATCH=15
MAX_CLAIMS_PER_BATCH=20
MAX_CHARS_PER_BATCH=24000

# Caching Layer (SHA-256 prompt content hashing to avoid duplicate calls)
ENABLE_LLM_CACHE=true
CACHE_TTL_SECONDS=86400
