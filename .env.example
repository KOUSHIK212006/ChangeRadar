# ==============================================================================
# ChangeRadar Root Environment Configuration (Docker Compose)
# ==============================================================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=changeradar

# Security
JWT_SECRET_KEY=change-radar-production-secret-key-at-least-32-chars-long

# Intelligence Engine Configuration
# Set to 'false' to enable live search and LLM calls
INTELLIGENCE_FIXTURE_MODE=true

# Tavily Search API Key
TAVILY_API_KEY=

# Centralized LLM Gateway (Bifrost - Maxim AI)
# All production LLM requests route through Bifrost (/v1/chat/completions)
BIFROST_BASE_URL=http://localhost:8088
BIFROST_API_KEY=
BIFROST_MODEL=gemini/gemini-3.5-flash-lite

# Google Gemini API Configuration (Upstream provider credentials forwarded via Bifrost)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# LLM Provider selection ("bifrost" | "gemini" | "groq" | "openai")
LLM_PROVIDER=bifrost

